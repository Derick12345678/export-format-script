Sub ExtractAllTextBoxesPreserveTables()

    Dim shp As Shape
    Dim srcRange As Range
    Dim destRange As Range
    Dim i As Long

    Dim extractedCount As Long
    Dim tableBoxCount As Long
    Dim failedCount As Long

    extractedCount = 0
    tableBoxCount = 0
    failedCount = 0

    ' Work backwards because shapes will be deleted
    For i = ActiveDocument.Shapes.Count To 1 Step -1

        Set shp = ActiveDocument.Shapes(i)

        If shp.TextFrame.HasText Then

            Set srcRange = shp.TextFrame.TextRange.Duplicate

            ' Count boxes containing tables
            If srcRange.Tables.Count > 0 Then
                tableBoxCount = tableBoxCount + 1
            End If

            ' Destination = location where text box is anchored
            Set destRange = shp.Anchor.Duplicate
            destRange.Collapse Direction:=wdCollapseStart

            On Error GoTo ExtractionFailed

            ' Copy EVERYTHING in the text box.
            ' This preserves tables, formatting, bold, etc.
            srcRange.Copy

            ' Paste into normal document body
            destRange.PasteAndFormat wdFormatOriginalFormatting

            ' Only delete the text box after successful paste
            shp.Delete

            extractedCount = extractedCount + 1

ContinueLoop:
            On Error GoTo 0

        End If

    Next i


    MsgBox "Extraction complete." & vbCrLf & vbCrLf & _
           "Text boxes extracted: " & extractedCount & vbCrLf & _
           "Boxes containing tables: " & tableBoxCount & vbCrLf & _
           "Failed/skipped: " & failedCount

    Exit Sub


ExtractionFailed:

    failedCount = failedCount + 1

    ' Do NOT delete the original text box if extraction failed
    Err.Clear
    Resume ContinueLoop

End Sub
