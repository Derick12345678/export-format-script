Sub RemoveHeaderLineShapes()

    Dim sec As Section
    Dim hdr As HeaderFooter
    Dim ftr As HeaderFooter
    Dim shp As Shape
    Dim i As Long
    Dim removedCount As Long

    removedCount = 0

    ' ------------------------------------------
    ' Remove line shapes from main document
    ' ------------------------------------------
    For i = ActiveDocument.Shapes.Count To 1 Step -1

        Set shp = ActiveDocument.Shapes(i)

        If shp.Type = msoLine Then
            shp.Delete
            removedCount = removedCount + 1
        End If

    Next i


    ' ------------------------------------------
    ' Remove line shapes from headers
    ' ------------------------------------------
    For Each sec In ActiveDocument.Sections

        For Each hdr In sec.Headers

            If hdr.Exists = True Then

                If hdr.Range.ShapeRange.Count > 0 Then

                    For i = hdr.Range.ShapeRange.Count To 1 Step -1

                        If hdr.Range.ShapeRange(i).Type = msoLine Then
                            hdr.Range.ShapeRange(i).Delete
                            removedCount = removedCount + 1
                        End If

                    Next i

                End If

            End If

        Next hdr

    Next sec


    ' ------------------------------------------
    ' Remove line shapes from footers
    ' ------------------------------------------
    For Each sec In ActiveDocument.Sections

        For Each ftr In sec.Footers

            If ftr.Exists = True Then

                If ftr.Range.ShapeRange.Count > 0 Then

                    For i = ftr.Range.ShapeRange.Count To 1 Step -1

                        If ftr.Range.ShapeRange(i).Type = msoLine Then
                            ftr.Range.ShapeRange(i).Delete
                            removedCount = removedCount + 1
                        End If

                    Next i

                End If

            End If

        Next ftr

    Next sec


    MsgBox removedCount & " line shapes were removed."

End Sub
